{
  "$schema": "../../../crates/tauri-schema-generator/schemas/config.schema.json",
  "productName": "Bypass Test",
  "version": "0.1.0",
  "identifier": "com.tauri.bypass",
  "build": {
    "frontendDist": ["../index.html"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Bypass Test",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
